---
/** Key-points summary at the end of a lesson (task M3-08). */
interface Props {
	points: string[];
}

const { points } = Astro.props;
---

<section class="hfld-keypoints not-content" aria-labelledby="key-points">
	<h2 id="key-points">Key points</h2>
	<ul>{points.map((p) => <li>{p}</li>)}</ul>
</section>

<style>
	.hfld-keypoints {
		margin-block: 2rem;
		padding: 1.25rem 1.5rem;
		border: var(--clay-edge);
		border-radius: var(--clay-radius);
		box-shadow: var(--clay-raised);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-gray-1);
	}
	.hfld-keypoints h2 {
		margin: 0 0 0.5rem;
		font-family: var(--hfld-font-heading);
		font-size: var(--sl-text-h4);
		color: var(--sl-color-white);
	}
	.hfld-keypoints ul {
		margin: 0;
		padding-inline-start: 1.25rem;
	}
	.hfld-keypoints li + li {
		margin-top: 0.375rem;
	}
</style>
