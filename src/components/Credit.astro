---
/**
 * Credit block at the end of every adapted lesson (task M3-01).
 * Names the original authors, the source, its date and every change made for the web.
 */
interface Props {
	/** Title of the original file, e.g. "EXERCISE D1: JavaScript basics in Google Earth Engine". */
	source: string;
	authors?: string;
	date?: string;
	changes?: string[];
}

const {
	source,
	authors = 'Ate Poortinga & Samuel (Conservation International)',
	date = 'May 2026',
	changes = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hfld-credit" aria-labelledby="credit-heading">
	<h2 id="credit-heading" class="hfld-credit__title">Credit</h2>
	<p>
		Adapted from <cite>{source}</cite> by {authors}, {`Bhutan ART-TREES HFLD Readiness Training, ${date}.`}
		{' '}Used with the trainers' permission. Content licence:{' '}
		<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>; code licence: MIT.
	</p>
	{
		changes.length > 0 && (
			<>
				<p class="hfld-credit__label">Changes from the source:</p>
				<ul>
					{changes.map((c) => (
						<li>{c}</li>
					))}
				</ul>
			</>
		)
	}
	<p class="hfld-credit__more">
		<a href={`${base}about/credits/`}>About the course and its authors</a>{' · '}<a href="https://github.com/wangdiues/bhutan-hfld-training/blob/main/CHANGELOG.md">All corrections</a>
	</p>
</section>

<style>
	.hfld-credit {
		margin-top: 3rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-top: 0.25rem solid var(--hfld-saffron);
		border-radius: 0.375rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.hfld-credit > :global(* + *) {
		margin-top: 0.5rem;
	}
	.hfld-credit__title {
		margin: 0;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	.hfld-credit__label {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.hfld-credit ul {
		margin-top: 0.25rem;
		padding-inline-start: 1.25rem;
	}
</style>
