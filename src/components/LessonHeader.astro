---
/**
 * Carpentries-style lesson overview (task M3-08): questions, objectives, time and
 * prerequisites. Objectives come from docs/learning-design.md.
 */
interface Props {
	questions: string[];
	objectives: string[];
	/** Minutes of teaching and of exercises. */
	teaching: number;
	exercises: number;
	prerequisites?: string[];
}

const { questions, objectives, teaching, exercises, prerequisites = [] } = Astro.props;
---

<section class="hfld-overview not-content" aria-label="Lesson overview">
	<dl class="hfld-overview__time">
		<div><dt>Teaching</dt><dd>{teaching} min</dd></div>
		<div><dt>Exercises</dt><dd>{exercises} min</dd></div>
	</dl>
	<div class="hfld-overview__cols">
		<div>
			<p class="hfld-overview__label">Questions</p>
			<ul>{questions.map((q) => <li>{q}</li>)}</ul>
		</div>
		<div>
			<p class="hfld-overview__label">Objectives</p>
			<ul>{objectives.map((o) => <li>{o}</li>)}</ul>
		</div>
	</div>
	{
		prerequisites.length > 0 && (
			<p class="hfld-overview__prereq">
				<span class="hfld-overview__label">Before you start:</span> {prerequisites.join(' · ')}
			</p>
		)
	}
</section>

<style>
	.hfld-overview {
		margin-block: 1.5rem 2rem;
		padding: 1.25rem 1.5rem;
		border: var(--clay-edge);
		border-radius: var(--clay-radius);
		background: var(--sl-color-gray-6);
		box-shadow: var(--clay-raised);
		color: var(--sl-color-gray-1);
	}
	.hfld-overview__time {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0 0 1rem;
	}
	/* Times sit in pressed-in clay chips. */
	.hfld-overview__time div {
		display: flex;
		gap: 0.375rem;
		align-items: baseline;
		padding: 0.375rem 0.875rem;
		border: var(--clay-edge);
		border-radius: var(--clay-radius-pill);
		background: var(--sl-color-black);
		box-shadow: var(--clay-pressed);
	}
	.hfld-overview__time dt,
	.hfld-overview__label {
		margin: 0;
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.hfld-overview__time dd {
		margin: 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.hfld-overview__cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem 2rem;
	}
	.hfld-overview ul {
		margin: 0.25rem 0 0;
		padding-inline-start: 1.25rem;
	}
	.hfld-overview li + li {
		margin-top: 0.25rem;
	}
	.hfld-overview__prereq {
		margin: 0.75rem 0 0;
		font-size: var(--sl-text-sm);
	}
</style>
