---
/**
 * Flags content that differs between TREES versions (task M3-09).
 *   <VersionNote standard="TREES 3.0" differs="TREES 2.0">…what changed…</VersionNote>
 */
interface Props {
	standard?: string;
	/** The version this content differs from. */
	differs?: string;
}

const { standard = 'TREES 3.0', differs = 'TREES 2.0' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const id = `version-${Math.random().toString(36).slice(2, 9)}`;
---

<aside class="hfld-version" aria-labelledby={id}>
	<p class="hfld-version__title" id={id}>
		<span class="hfld-version__badge">{standard}</span> Differs from {differs}
	</p>
	<div class="hfld-version__body"><slot /></div>
	<p class="hfld-version__more"><a href={`${base}explanation/trees-2-to-3/`}>What changed from TREES 2.0 to 3.0</a></p>
</aside>

<style>
	.hfld-version {
		padding: 0.75rem 1rem;
		border: 1px dashed var(--hfld-saffron);
		border-radius: 0.375rem;
		background: var(--hfld-saffron-bg);
		color: var(--sl-color-white);
	}
	.hfld-version__title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-weight: 600;
		color: var(--hfld-saffron-text);
	}
	.hfld-version__badge {
		padding: 0.05rem 0.5rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
	}
	.hfld-version__body > :global(:first-child) {
		margin-top: 0.5rem;
	}
	.hfld-version__more {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
	}
</style>
