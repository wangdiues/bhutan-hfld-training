---
/**
 * Buttons under a script (task M3-02): open the original Code Editor script, and download
 * the course copy from scripts/gee/ (served by src/pages/scripts/[...path].ts).
 */
interface Props {
	/** Path under scripts/gee/, e.g. "day-1/custom-functions.js". */
	script: string;
	/** Code Editor share hash of the original script (code.earthengine.google.com/<hash>). */
	hash?: string;
}

const { script, hash } = Astro.props;
const scripts = import.meta.glob('/scripts/gee/**/*.js', { query: '?raw', import: 'default' });
if (!scripts[`/scripts/gee/${script}`]) throw new Error(`OpenInGEE: scripts/gee/${script} does not exist`);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = script.split('/').pop();
---

<div class="hfld-gee-actions not-content">
	{
		hash && (
			<a class="hfld-gee-btn hfld-gee-btn--primary" href={`https://code.earthengine.google.com/${hash}`}>
				Open in the Code Editor<span class="sr-only"> (opens the original script on Earth Engine)</span>
			</a>
		)
	}
	<a class="hfld-gee-btn" href={`${base}scripts/${script}`} download={name}>Download {name}</a>
</div>

<style>
	.hfld-gee-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block: 1rem;
	}
	.hfld-gee-btn {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: var(--clay-radius-pill);
		background: var(--sl-color-black);
		box-shadow: var(--clay-raised-sm);
		color: var(--sl-color-accent-high);
		font-weight: 600;
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.hfld-gee-btn--primary {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	:root[data-theme='light'] .hfld-gee-btn--primary {
		color: #ffffff;
	}
	.hfld-gee-btn:active {
		box-shadow: var(--clay-pressed);
	}
	.hfld-gee-btn:hover {
		text-decoration: underline;
	}
	.hfld-gee-btn:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}
</style>
