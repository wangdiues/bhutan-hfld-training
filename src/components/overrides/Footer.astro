---
/**
 * Starlight Footer override (task M6-01): adds a "Mark this lesson complete" toggle above the
 * default footer on lesson pages. Progress is saved in this browser only. Trainer mode (task
 * M6-04) adds the timetable slots and facilitator notes for the lesson, shown only when the
 * trainer-mode toggle is on (<html data-trainer>).
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import { isLessonKey, pageKey } from '~/lib/progress';
import { AGENDA, sessionsFor } from '~/data/agenda';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const key = pageKey(Astro.url.pathname, base);
const lesson = isLessonKey(key);
const slots = sessionsFor(key);
const days = [...new Set(slots.map((s) => s.day))];
---

{
	slots.length > 0 && (
		<aside class="hfld-trainer" aria-labelledby="hfld-trainer-title">
			<p class="hfld-trainer__title" id="hfld-trainer-title">
				Trainer notes
			</p>
			<p>In the May 2026 timetable:</p>
			<ul>
				{slots.map(({ day, session }) => (
					<li>
						Day {day}, {session.time}: {session.title}
					</li>
				))}
			</ul>
			{days.map((d) => (
				<>
					<p>Day {d} facilitation:</p>
					<ul>
						{AGENDA.find((a) => a.day === d)!.notes.map((n) => (
							<li>{n}</li>
						))}
					</ul>
				</>
			))}
			<p class="hfld-trainer__off">
				<a href={`${base}about/trainer-mode/`}>Trainer mode</a> is on in this browser.
			</p>
		</aside>
	)
}

{
	lesson && (
		<hfld-complete class="hfld-complete" data-key={key}>
			<button type="button" aria-pressed="false">
				<span class="hfld-complete__box" aria-hidden="true" />
				<span data-label>Mark this lesson complete</span>
			</button>
			<p class="hfld-complete__note" data-note>
				Progress is saved in this browser only. Your progress per day shows in the sidebar.
			</p>
		</hfld-complete>
	)
}
<Default />

<script>
	import { loadDone, setDone } from '~/lib/progress';

	class HfldComplete extends HTMLElement {
		connectedCallback() {
			const key = this.dataset.key!;
			const btn = this.querySelector('button')!;
			const label = this.querySelector('[data-label]')!;
			const render = (done: boolean) => {
				btn.setAttribute('aria-pressed', String(done));
				label.textContent = done ? 'Lesson complete' : 'Mark this lesson complete';
			};
			render(loadDone().has(key));
			btn.addEventListener('click', () => {
				const done = btn.getAttribute('aria-pressed') !== 'true';
				const saved = setDone(key, done);
				render(saved.has(key));
				if (saved.has(key) !== done) this.querySelector('[data-note]')!.textContent = 'Progress could not be saved: this browser blocks site storage.';
			});
		}
	}
	customElements.define('hfld-complete', HfldComplete);
</script>

<style is:global>
	.hfld-trainer {
		display: none;
	}
	:root[data-trainer] .hfld-trainer {
		display: block;
		margin-block: 2rem 0;
		padding: 0.75rem 1rem;
		border: 1px dashed var(--sl-color-orange);
		border-radius: var(--clay-radius);
		background: var(--sl-color-orange-low);
		box-shadow: var(--clay-raised);
		font-size: var(--sl-text-sm);
	}
	.hfld-trainer__title {
		font-weight: 700;
		margin: 0;
	}
	.hfld-trainer ul {
		margin-top: 0.25rem;
	}
	.hfld-trainer__off {
		color: var(--sl-color-gray-2);
	}
</style>

<style>
	.hfld-complete {
		display: block;
		margin-block: 2rem 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.hfld-complete button {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 1rem;
		border: 2px solid var(--sl-color-accent);
		border-radius: var(--clay-radius-pill);
		background: var(--sl-color-black);
		box-shadow: var(--clay-raised-sm);
		color: var(--sl-color-white);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.hfld-complete button:focus-visible {
		outline: 3px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.hfld-complete button[aria-pressed='true'] {
		background: var(--sl-color-accent-low);
		box-shadow: var(--clay-pressed);
	}
	.hfld-complete__box {
		width: 1.1rem;
		height: 1.1rem;
		border: 2px solid var(--sl-color-accent);
		border-radius: 0.2rem;
		display: inline-grid;
		place-items: center;
	}
	.hfld-complete button[aria-pressed='true'] .hfld-complete__box::after {
		content: '✓';
		font-size: 0.85rem;
		line-height: 1;
	}
	.hfld-complete__note {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
