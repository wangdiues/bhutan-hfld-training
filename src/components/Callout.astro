---
/**
 * Lesson callout. Five teaching variants (task M3-03):
 *   why          — why this step matters
 *   implication  — training implication (what it means for the model or the MRV report)
 *   mistake      — common mistake
 *   theory       — background theory
 *   bhutan       — Bhutan context
 * Renders an <aside> labelled by its visible title, so screen readers announce it as a
 * named complementary region. Icons are decorative (aria-hidden).
 */
interface Props {
	type?: 'why' | 'implication' | 'mistake' | 'theory' | 'bhutan';
	/** Overrides the default title for the type. */
	title?: string;
}

const variants = {
	why: { title: 'Why this step matters', icon: 'M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Zm-3 18h6v2H9z' },
	implication: { title: 'Training implication', icon: 'M4 4h16v12H5.2L4 17.2zM7 8h10M7 12h7' },
	mistake: { title: 'Common mistake', icon: 'M12 3 2 21h20zM12 10v5M12 18h.01' },
	theory: { title: 'Theory', icon: 'M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h7z' },
	bhutan: { title: 'Bhutan context', icon: 'M3 20 9 9l4 6 3-4 5 9zM17 4a2 2 0 1 1 0 4 2 2 0 0 1 0-4' },
} as const;

const { type = 'why', title } = Astro.props;
const v = variants[type] ?? variants.why;
const heading = title ?? v.title;
const id = `callout-${Math.random().toString(36).slice(2, 9)}`;
---

<aside class:list={['hfld-callout', `hfld-callout--${type}`]} aria-labelledby={id}>
	<p class="hfld-callout__title" id={id}>
		<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d={v.icon}></path>
		</svg>
		{heading}
	</p>
	<div class="hfld-callout__body"><slot /></div>
</aside>

<style>
	.hfld-callout {
		--c-border: var(--sl-color-accent);
		--c-bg: var(--sl-color-accent-low);
		--c-title: var(--sl-color-accent-high);
		border-inline-start: 0.25rem solid var(--c-border);
		background: var(--c-bg);
		color: var(--sl-color-white);
		padding: 0.75rem 1rem;
		border-radius: 0 0.375rem 0.375rem 0;
	}
	.hfld-callout--implication {
		--c-border: var(--sl-color-blue);
		--c-bg: var(--sl-color-blue-low);
		--c-title: var(--sl-color-blue-high);
	}
	.hfld-callout--mistake {
		--c-border: var(--sl-color-red);
		--c-bg: var(--sl-color-red-low);
		--c-title: var(--sl-color-red-high);
	}
	.hfld-callout--theory {
		--c-border: var(--sl-color-purple);
		--c-bg: var(--sl-color-purple-low);
		--c-title: var(--sl-color-purple-high);
	}
	.hfld-callout--bhutan {
		--c-border: var(--hfld-saffron);
		--c-bg: var(--hfld-saffron-bg);
		--c-title: var(--hfld-saffron-text);
	}
	.hfld-callout__title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-weight: 600;
		color: var(--c-title);
	}
	.hfld-callout__body {
		margin-top: 0.5rem;
	}
	.hfld-callout__body > :global(:first-child) {
		margin-top: 0;
	}
	@media (forced-colors: active) {
		.hfld-callout {
			border: 1px solid CanvasText;
			border-inline-start-width: 0.25rem;
		}
	}
</style>
